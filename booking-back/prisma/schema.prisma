// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CUSTOMER
  BUSINESS_OWNER
  ADMIN
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
  TRIAL
}

enum VerificationEntityType {
  USER
  STAFF
  BUSINESS
  BOOKING
}

enum VerificationChannel {
  SMS
  EMAIL
}

enum VerificationPurpose {
  PHONE_VERIFICATION
  LOGIN_OTP
  PASSWORD_RESET_OTP
}


enum BillingPeriod {
  MONTHLY
  QUARTERLY
  HALF_YEARLY
  YEARLY
}

enum BookingStatus {
   UNVERIFIED
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}
enum SmsStatus {
  PENDING
  SENT
  DELIVERED
  FAILED
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum NotificationType {
  BOOKING_CONFIRMATION
  BOOKING_REMINDER
  BOOKING_CANCELLATION
  PAYMENT_RECEIVED
  NEW_REVIEW
  APPOINTMENT_APPROACHING
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String?
  firstName String
  lastName  String
  phone     String?
  avatar    String?
  role      UserRole @default(CUSTOMER)

  isEmailVerified Boolean @default(false)
  emailVerificationCode String? @unique
  emailVerificationCodeExpires DateTime?
  emailVerificationAttempts Int @default(0)

  passwordResetToken String? @unique
  passwordResetExpiresAt DateTime?

  isPhoneVerified Boolean @default(false)
  phoneVerificationCode String? @unique
  phoneVerificationCodeExpires DateTime?
  phoneVerificationAttempts Int @default(0)

  googleId      String?   @unique  
  authProvider  AuthProvider @default(EMAIL)

  business           Business?
  bookingsAsCustomer Booking[]
  reviews            Review[]
  notifications      Notification[]
  pushSubscriptions  PushSubscription[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum AuthProvider {
  EMAIL
  GOOGLE
  FIREBASE
}

model Business {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name        String
  description String?
  logo        String?
  coverImage  String?
  email       String
  phone       String
  website     String?
  category    String

  address String
  city    String
  state   String
  zipCode String
  country String

  isVerified Boolean @default(false)
  isActive   Boolean @default(true)
  rating     Float   @default(0)
  isPhoneVerified Boolean @default(false)

  // Metadata - stored as JSON
  socialMedia             Json? 
  notificationSettings    Json? 
  smsNotificationsEnabled Boolean @default(false) 
  smsLogs SMSLog[]

  subscription Subscription?

  services  Service[]
  staff     Staff[]
  bookings  Booking[]
  payments  Payment[]
  reviews   Review[]
  hours     BusinessHours[]
  closedDates ClosedDate[]
  customers Customer[]
  timeOffs    TimeOff[]
 

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model SMSLog {
  id             String        @id @default(cuid())

  businessId     String?
  business       Business?     @relation(fields: [businessId], references: [id], onDelete: SetNull)

  subscriptionId String?
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  phoneNumber    String
  message        String
  type           String
  status         String
  messageId      String?
  provider       String        @default("SPARROW")
  errorMessage   String?

  createdAt      DateTime      @default(now())

  @@index([businessId])
  @@index([phoneNumber])
  @@index([status])
  @@index([type])
  @@map("sms_logs")
}

model VerificationCode {
  id          String   @id @default(cuid())

  entityType  VerificationEntityType
  entityId    String

  channel     VerificationChannel
  purpose     VerificationPurpose

  destination String    // phone number (or email, if channel = EMAIL later) the code was sent to
  code        String
  expiresAt   DateTime
  attempts    Int       @default(0)
  consumedAt  DateTime?
  sentAt      DateTime  @default(now())

  createdAt   DateTime  @default(now())

  @@index([entityType, entityId, purpose])
  @@index([destination])
  @@map("verification_codes")
}


// Staff member who works at a business
model Staff {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  firstName   String
  lastName    String
  email       String @unique
  phone       String?
  avatar      String?
  role        String   @default("Staff")
  isActive    Boolean  @default(true)
  
  // Email verification
  emailVerified               Boolean   @default(false)
  verificationToken           String?   @unique
  verificationTokenExpiresAt  DateTime?

  isPhoneVerified Boolean @default(false)

    // Password authentication
  password                    String?   // Hashed password, null until staff sets it
  passwordResetToken          String?   @unique
  passwordResetExpiresAt      DateTime?
  
  // Public booking link - unique code for staff direct booking page
  staffCode   String   @unique @default(cuid())
  
  // Working hours per day (JSON): { "monday": { "start": "09:00", "end": "17:00", "isWorking": true }, ... }
  workingHours Json?
  
  // Break times (JSON): [{ "start": "12:00", "end": "13:00" }]
  breakTimes   Json?

  services  StaffService[]
  bookings  Booking[]
  timeOffs  TimeOff[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([businessId])
  @@index([isActive])
  @@index([staffCode])
}

// Join table connecting staff to services they can perform
model StaffService {
  id        String  @id @default(cuid())
  staffId   String
  staff     Staff   @relation(fields: [staffId], references: [id], onDelete: Cascade)
  serviceId String
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([staffId, serviceId])
  @@index([staffId])
  @@index([serviceId])
}

model Service {
  id         String @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  name        String
  description String?
  price       Float
  offerPrice  Float?
  duration    Int
  image       String?
  isActive    Boolean @default(true)
  capacity    Int     @default(1)

  staffServices StaffService[]
  bookings      Booking[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Customer {
  id         String @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  name  String
  email String
  phone String
  notes String?
  isEmailVerified Boolean @default(false)
  isPhoneVerified Boolean @default(false)

  totalBookings Int   @default(0)
  totalSpent    Float @default(0)
  lastVisit     DateTime?

  bookings Booking[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([businessId, email])
}

model Booking {
  id         String @id @default(cuid())
  serviceId  String
  service    Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  // Optional staff assignment
  staffId    String?
  staff      Staff? @relation(fields: [staffId], references: [id], onDelete: SetNull)

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  userId String?
  user   User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  startTime     DateTime
  endTime       DateTime
  customerName  String
  customerEmail String
  customerPhone String
  notes         String?

  status BookingStatus @default(PENDING)

  // Email verification for public bookings
  verificationToken String? @unique
  verificationTokenExpires DateTime?
  isEmailVerified Boolean @default(false)

  phoneVerificationCode        String?
  phoneVerificationCodeExpires DateTime?
  phoneVerificationAttempts    Int       @default(0)
  isPhoneVerified               Boolean   @default(false)

  notifications Notification[] @relation("BookingNotifications")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([staffId])
}

model Payment {
  id                String   @id @default(cuid())

  businessId        String
  business          Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  // Subscription payment (optional)
  subscriptionId    String?
  subscription      Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  gateway           String
  transactionId     String   @unique
  amount            Int
  status            String   @default("pending")

  esewaRefId        String?  @unique
  esewaProductCode  String?

  khaltiPidx        String?
  khaltiToken       String?

  nabilRefId        String?  @unique

  reference         String?
  customerEmail     String?
  customerPhone     String?
  payload           Json?
  errorMessage      String?
  currency          String   @default("NPR")

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([businessId])
  @@index([status])
  @@index([gateway])
  @@map("payments")
}

model Review {
  id         String @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  userId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  rating  Int
  title   String?
  comment String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([businessId, userId])
}

model BusinessHours {
  id         String @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  dayOfWeek Int
  openTime  String
  closeTime String
  isClosed  Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([businessId, dayOfWeek])
}

model Notification {
  id     String @id @default(cuid())
  userId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  bookingId String?
  booking   Booking? @relation("BookingNotifications", fields: [bookingId], references: [id], onDelete: SetNull)

  type    NotificationType
  title   String
  message String
  isRead  Boolean @default(false)

  createdAt DateTime @default(now())
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  endpoint  String   @unique  // Web Push service endpoint
  p256dh   String
  auth     String
  isActive  Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, endpoint])
  @@index([userId])
  @@index([isActive])
  @@map("push_subscriptions")
}

model SubscriptionPlan {
  id            String   @id @default(cuid())
  name          String   @unique 
  priceNPR      Int     // Base monthly price
  displayName   String   
  features      String[] @default([])
  description   String?
  durationDays  Int      @default(30)
  currency      String   @default("NPR")
  active        Boolean  @default(true)
  
  // Pricing for different billing periods (with discounts)
  priceMonthlyNPR      Int  // Monthly billing
  priceQuarterlyNPR    Int? // 3 months with discount
  priceSemiAnnualNPR   Int? // 6 months with discount
  priceAnnualNPR       Int? // 12 months with discount
  
  // Plan Limits
  maxAppointmentsPerMonth  Int  @default(-1)  // -1 means unlimited
  maxStaff                 Int  @default(-1)  // -1 means unlimited
  maxServices              Int  @default(-1)  // -1 means unlimited
  maxCustomers             Int  @default(-1)  // -1 means unlimited
  maxSmsPerMonth           Int  @default(0)
  
  // Features flags (Email-only notifications)
  allowEmailNotifications  Boolean @default(true)
  allowSmsNotifications    Boolean @default(false)
  allowOnlineBooking       Boolean @default(true)
  allowReports             Boolean @default(false)
  allowCustomBranding      Boolean @default(false)
  prioritySupport          Boolean @default(false)
  
  subscriptions Subscription[]

  @@index([active])
  @@map("subscription_plans")
}

model Subscription {
  id              String   @id @default(cuid())

  businessId      String   @unique
  business        Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  planId          String
  plan            SubscriptionPlan @relation(fields: [planId], references: [id])

  status          SubscriptionStatus @default(TRIAL)
  
  // Billing period tracking
  billingPeriod   BillingPeriod @default(MONTHLY)
  billingCycleEndDate DateTime?

  startDate       DateTime?
  endDate         DateTime?

  autoRenew       Boolean  @default(true)
  lastPaymentId   String?
  nextRenewalDate DateTime?

  trialEndsAt     DateTime?
  isTrialUsed     Boolean  @default(false)
  cancelledAt     DateTime?
  
  // Usage tracking
  appointmentsThisMonth    Int      @default(0)
  usageResetDate           DateTime?

  smsUsedThisMonth Int      @default(0)
  smsCreditBalance Int      @default(0)
  smsLogs          SMSLog[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  payments        Payment[]

  @@index([status])
  @@index([endDate])
  @@map("subscriptions")
}


model TimeOff {
  id        String   @id @default(cuid())
  businessId String
  business  Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  
  staffId   String?
  staff     Staff?   @relation(fields: [staffId], references: [id], onDelete: Cascade)
  
  startDate DateTime
  endDate   DateTime
  reason    String?
  type      String   @default("BREAK") // BREAK, SICK_LEAVE, VACATION, OTHER
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([businessId])
  @@index([staffId])
  @@index([startDate])
  @@map("time_offs")
}

model ClosedDate {
  id         String @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  date   DateTime
  reason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([businessId, date])
  @@index([businessId])
}
