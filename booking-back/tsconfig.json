{
  "compilerOptions": {
    
    "target": "ES2020",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "outDir": "./dist",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "rootDir": "./",
    "types": ["node"]
  },
  "include": ["src","prisma","scripts", "../booking/app/constants", "../booking/lib/firebase.ts"],
  "exclude": ["node_modules", "dist"]
}
